        { id: 51, q: "불만 시 참여 철회/이동 표시 행동: ( ____ ) with Feet", ans: ["Vote", "vote"], exp: "[Page 43] Vote with Feet 입니다." },
        { id: 52, q: "개인 취향과 참여를 존중하는 정책 관점: 문화(적) ( ____ )주의", ans: ["민주", "민주주의"], exp: "[Page 49, 50] 문화민주주의입니다." },
        { id: 53, q: "문화민주주의의 중심 대상: ( ____ )", ans: ["아마추어"], exp: "[Page 50] 아마추어 중심입니다." },
        { id: 54, q: "여러 출처의 정보 조각을 통합하는 사고: ( ____ ) 사고", ans: ["통합", "통합적"], exp: "[Page 56] 통합 사고입니다." },
        { id: 55, q: "정답이 없을 수 있음을 허용하는 태도: ( ____ )을 이해하는 사고", ans: ["모호함"], exp: "[Page 58] 모호함을 이해하는 사고입니다." },
        { id: 56, q: "생산 비용을 축소하기 어려운 특징: ( ____ )성", ans: ["경직", "경직성"], exp: "[Page 65] 경직성입니다." },
        { id: 57, q: "『유한계급론』 저자: ( ____ )", ans: ["베블런", "Veblen"], exp: "[Page 66] 베블런입니다." },
        { id: 58, q: "구매 전 품질 평가 가능 재화: ( ____ )재", ans: ["탐색", "탐색재"], exp: "[Page 68] 탐색재입니다." },
        { id: 59, q: "시장 거래 시 발생하는 비용: ( ____ )비용", ans: ["거래"], exp: "[Page 76, 78] 거래비용입니다." },
        { id: 60, q: "STEPS Initiative 4대 키워드: 예술, 지역, 도시, ( ____ )", ans: ["참여"], exp: "[Page 94] 참여입니다." }
      ],
      essay: [
        {
          id: 61,
          q: "문화적 할인율(Cultural Discount)의 개념 및 극복 전략 3가지를 서술하시오.",
          exp: "■ 개념: 타 문화권 진입 시 문화적 차이로 가치나 매력도가 감소하는 현상.\n■ 극복 전략 3가지:\n1. 현지화 (Localization)\n2. 보편적 소재 활용\n3. 단계적 시장 진출"
        },
        {
          id: 62,
          q: "서비스로서 문화예술의 4가지 특성과 극복 방안을 서술하시오.",
          exp: "1. 무형성: 스토리텔링 및 경험 유형화\n2. 소멸성: NT Live 등 영상화/기록\n3. 이질성: 유통망 및 서비스 표준화\n4. 비분리성: 무대 현장성 및 관객 호흡 관리"
        },
        {
          id: 63,
          q: "팔길이 원칙(Arm's Length Principle)의 개념과 목적을 서술하시오.",
          exp: "■ 개념: '지원하되 간섭하지 않는다' - 행정/정치적 직접 간섭 배제.\n■ 목적: 예술의 자율성, 독립성, 다양성 보장."
        },
        {
          id: 64,
          q: "문화의 민주화 vs 문화민주주의를 비교 서술하시오.",
          exp: "1. 문화의 민주화: 'The best for the most' - 고급문화를 모든 이에게 분배 (전문가/기관 중심)\n2. 문화민주주의: 'Culture by everybody' - 모두의 창조적 참여 (아마추어/다양성 중심)"
        },
        {
          id: 65,
          q: "로날드 코즈의 거래비용 이론 및 기업 형성 원리를 서술하시오.",
          exp: "■ 핵심: 시장 거래에는 탐색, 협상, 계약 등 거래비용이 수반됨.\n■ 기업 형성 원리: 거래비용이 높을수록 시장 거래보다 내부적 조직(기업)을 통한 관리가 더 효율적임."
        }
      ]
    };

    let answeredCount = new Set();

    function switchTab(tab) {
      document.getElementById('section-mcq').classList.add('hidden');
      document.getElementById('section-short').classList.add('hidden');
      document.getElementById('section-essay').classList.add('hidden');

      ['mcq', 'short', 'essay'].forEach(t => {
        const btn = document.getElementById(`tab-${t}`);
        if(t === tab) {
          btn.className = "px-3.5 py-2 rounded-lg transition-all bg-indigo-600 text-white shadow font-semibold";
        } else {
          btn.className = "px-3.5 py-2 rounded-lg transition-all text-indigo-200 hover:text-white";
        }
      });

      document.getElementById(`section-${tab}`).classList.remove('hidden');
      const titleMap = { mcq: 'PART 1. 객관식 문항 (30문항)', short: 'PART 2. 빈칸형 단답식 (30문항)', essay: 'PART 3. 주관식 서술형 (5문항)' };
      document.getElementById('current-category').innerText = titleMap[tab];
    }

    function initApp() {
      const mcqHtml = quizData.mcq.map((item, idx) => `
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 space-y-4">
          <div class="flex items-start gap-3">
            <span class="bg-indigo-100 text-indigo-800 font-bold text-xs px-2.5 py-1 rounded-md mt-0.5">Q${item.id}</span>
            <h3 class="text-sm font-semibold text-slate-800 flex-1">${item.q}</h3>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2">
            ${item.options.map((opt, oIdx) => `
              <button onclick="checkMCQ(${idx}, ${oIdx})" id="mcq-btn-${idx}-${oIdx}" class="text-left px-4 py-3 rounded-xl border border-slate-200 hover:bg-indigo-50 transition-all text-xs font-medium text-slate-700">
                ${oIdx + 1}. ${opt}
              </button>
            `).join('')}
          </div>
          <div id="mcq-exp-${idx}" class="hidden p-4 rounded-xl bg-slate-50 border-l-4 border-indigo-600 text-xs text-slate-700">
            <div id="mcq-res-${idx}" class="font-bold text-sm mb-1"></div>
            <div>${item.exp}</div>
          </div>
        </div>
      `).join('');
      document.getElementById('container-mcq').innerHTML = mcqHtml;

      const shortHtml = quizData.short.map((item, idx) => `
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 space-y-4">
          <div class="flex items-start gap-3">
            <span class="bg-emerald-100 text-emerald-800 font-bold text-xs px-2.5 py-1 rounded-md mt-0.5">Q${item.id}</span>
            <h3 class="text-sm font-semibold text-slate-800 flex-1">${item.q}</h3>
          </div>
          <div class="flex gap-2 max-w-md pt-1">
            <input type="text" id="short-input-${idx}" onkeypress="if(event.key==='Enter') checkShort(${idx})" placeholder="정답 입력" class="flex-1 px-4 py-2 text-xs rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500">
            <button onclick="checkShort(${idx})" class="px-4 py-2 bg-emerald-600 text-white rounded-xl text-xs font-semibold hover:bg-emerald-700">확인</button>
          </div>
          <div id="short-exp-${idx}" class="hidden p-4 rounded-xl bg-slate-50 border-l-4 border-emerald-600 text-xs text-slate-700">
            <div id="short-res-${idx}" class="font-bold text-sm mb-1"></div>
            <div>${item.exp}</div>
          </div>
        </div>
      `).join('');
      document.getElementById('container-short').innerHTML = shortHtml;

      const essayHtml = quizData.essay.map((item, idx) => `
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 space-y-4">
          <div class="flex items-start gap-3">
            <span class="bg-purple-100 text-purple-800 font-bold text-xs px-2.5 py-1 rounded-md mt-0.5">Q${item.id}</span>
            <h3 class="text-sm font-semibold text-slate-800 flex-1">${item.q}</h3>
          </div>
          <div class="space-y-3 pt-1">
            <textarea id="essay-input-${idx}" rows="3" placeholder="답안을 서술해 보세요..." class="w-full px-4 py-3 text-xs rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-purple-500"></textarea>
            <button onclick="toggleEssay(${idx})" class="px-4 py-2 bg-purple-600 text-white rounded-xl text-xs font-semibold hover:bg-purple-700">모범 답안 보기</button>
          </div>
          <div id="essay-exp-${idx}" class="hidden p-4 rounded-xl bg-purple-50 border-l-4 border-purple-600 text-xs text-slate-800 whitespace-pre-line">
            <div class="font-bold text-sm text-purple-900 mb-1">[모범 답안]</div>
            ${item.exp}
          </div>
        </div>
      `).join('');
      document.getElementById('container-essay').innerHTML = essayHtml;
    }

    function checkMCQ(qIdx, selectedOpt) {
      const q = quizData.mcq[qIdx];
      const isCorrect = selectedOpt === q.ans;
      for (let i = 0; i < q.options.length; i++) {
        const btn = document.getElementById(`mcq-btn-${qIdx}-${i}`);
        btn.disabled = true;
        if (i === q.ans) btn.className = "text-left px-4 py-3 rounded-xl border border-emerald-500 bg-emerald-50 font-bold text-emerald-800 text-xs";
        else if (i === selectedOpt) btn.className = "text-left px-4 py-3 rounded-xl border border-rose-500 bg-rose-50 font-bold text-rose-800 text-xs";
        else btn.className = "text-left px-4 py-3 rounded-xl border border-slate-200 opacity-40 text-xs";
      }
      const resBox = document.getElementById(`mcq-res-${qIdx}`);
      resBox.innerText = isCorrect ? "정답입니다! ⭕" : "오답입니다. ❌";
      resBox.className = isCorrect ? "font-bold text-sm text-emerald-600 mb-1" : "font-bold text-sm text-rose-600 mb-1";
      document.getElementById(`mcq-exp-${qIdx}`).classList.remove('hidden');
      updateProgress(`mcq-${qIdx}`);
    }

    function checkShort(qIdx) {
      const q = quizData.short[qIdx];
      const val = document.getElementById(`short-input-${qIdx}`).value.trim().toLowerCase();
      const isCorrect = q.ans.some(a => a.toLowerCase() === val);
      const resBox = document.getElementById(`short-res-${qIdx}`);
      resBox.innerText = isCorrect ? "정답입니다! ⭕" : `오답입니다. (정답: ${q.ans[0]}) ❌`;
      resBox.className = isCorrect ? "font-bold text-sm text-emerald-600 mb-1" : "font-bold text-sm text-rose-600 mb-1";
      document.getElementById(`short-exp-${qIdx}`).classList.remove('hidden');
      updateProgress(`short-${qIdx}`);
    }

    function toggleEssay(qIdx) {
      document.getElementById(`essay-exp-${qIdx}`).classList.toggle('hidden');
      updateProgress(`essay-${qIdx}`);
    }

    function updateProgress(key) {
      answeredCount.add(key);
      document.getElementById('progress-text').innerText = answeredCount.size;
    }

    window.onload = initApp;
  </script>
</body>
</html>
